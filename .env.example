# ==== API Keys ====
# config.yaml 中 api_key: $VAR 引用这里的环境变量
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ==== 数据库（集群部署时启用）====
# config.yaml 中 database.postgres_url: $DATABASE_URL 引用
# 集群多节点共享会话状态必须用 postgres
DATABASE_URL=postgresql://user:pass@host:5432/deerflow

# ==== 可选：覆盖 config.yaml 路径 ====
# AGENT_CONFIG_PATH=/path/to/config.yaml

# ==== 可选：覆盖日志 ====
# LOG_LEVEL=DEBUG
# LOG_FILE=logs/app.log
