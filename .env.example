# ==== API Keys ====
# LLM 实例（app/llm/instances/）通过 api_key_env 引用这里的环境变量
OPENAI_API_KEY=xxx
DEEPSEEK_API_KEY=xxx
# 可选：DeepSeek 备用 key（实例 deepseek_bak 使用，key 变化时切换角色引用）
# DEEPSEEK_API_KEY_2=xxx
# 可选：通义千问（实例 qwen / qwen_vl 使用）
# DASHSCOPE_API_KEY=xxx
# OPENAI_API_BASE_URL=https://api.deepseek.com

# ==== 可选：覆盖 config.yaml 路径 ====
# AGENT_CONFIG_PATH=/path/to/config.yaml

# ==== Langfuse ====
LANGFUSE_SECRET_KEY="sk-lf-ad558f07-d107-4754-98e2-5462f2b81d15"
LANGFUSE_PUBLIC_KEY="pk-lf-7f24e9d2-926e-4b43-ad8f-12207f307344"
LANGFUSE_BASE_URL="http://xxx:xxx"

# ==== 可选：覆盖日志 ====
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log


POSTGRES_URL=xxx

TAVILY_API_KEY=xxx

# ==== 知识库摄取（语雀 + ElasticSearch）====
# 语雀个人令牌（https://www.yuque.com/settings/tokens）
YUQUE_TOKEN=xxx
# 拉取知识库的登录名（个人/组织登录名）
YUQUE_LOGIN=xxx
# Embedding API Key（如 OpenAI text-embedding-3-small）
EMBEDDING_API_KEY=xxx